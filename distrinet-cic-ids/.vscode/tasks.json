{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "IDS: Inspect Parquet",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "src.cli", "inspect"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "IDS: Start Streamlit",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "streamlit", "run", "app/app.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
